# ===== LLM (локальная Ollama по умолчанию) =====
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3.5:4b
LLM_API_KEY=

# AI: changing model/dimensions requires re-ingestion.
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768
TIMEOUT_SECONDS=180
RAG_MAX_DISTANCE=0.35
RAG_TOP_K=3
# 32+ random chars shared only by Go and AI. Generate locally with:
# openssl rand -hex 32
# Empty disables the AI-agent flow and keeps the deterministic demo chat.
AI_INTERNAL_TOKEN=

# ===== PostgreSQL + pgvector =====
POSTGRES_USER=avito
POSTGRES_PASSWORD=avito
POSTGRES_DB=aibuddy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===== Backend (Go) =====
PORT=8080
DATABASE_URL=postgres://avito:avito@postgres:5432/aibuddy?sslmode=disable
AI_SERVICE_URL=http://ai-service:8000

# Frontend uses same-origin /api proxy in Docker and Vite development server.
# Optional local backend proxy target for `npm run dev`:
# BACKEND_PROXY_URL=http://localhost:18080

# Backend: AI HTTP timeout (1s..10m), supports cold local model startup
AI_REQUEST_TIMEOUT=180s
